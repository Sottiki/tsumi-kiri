{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.84",
        "--isolated",
        "--headless",
        "--allowed-origins",
        "http://localhost:5173",
        "--viewport-size",
        "1512x982",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
